{
    "name": "tinovn/laravel-tinopay",
    "description": "Laravel Package cho TinoPay - Tự động xác nhận thanh toán chuyển khoản ngân hàng",
    "keywords": [
        "TinoPay",
        "laravel",
        "laravel-tinopay"
    ],
    "homepage": "https://github.com/tinovn/laravel-tinopay",
    "license": "MIT",
    "authors": [
        {
            "name": "Tino Group",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^9.28 | ^10.0 | ^11.0 | ^12.0 | ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^8.8 | ^9.0 | ^10.0",
        "pestphp/pest": "^2.20 | ^3.0",
        "pestphp/pest-plugin-laravel": "^2.0 | ^3.0"
    },
    "autoload": {
        "psr-4": {
            "TinoPay\\TinoPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TinoPay\\TinoPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TinoPay\\TinoPay\\TinoPayServiceProvider"
            ],
            "aliases": {
                "TinoPay": "TinoPay\\TinoPay\\Facades\\TinoPay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
